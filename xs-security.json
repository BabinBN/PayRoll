{
  "xsappname": "payroll",
  "tenant-mode": "dedicated",
  "description": "Security profile of called application",
  "scopes": [
    {
      "name": "uaa.user",
      "description": "UAA"
    },
    {
      "name": "$XSAPPNAME.EmployeeViewer",
      "description": "View employee data"
    },
    {
      "name": "$XSAPPNAME.EmployeeAdmin",
      "description": "Manage employee data"
    }
  ],
  "role-templates": [
    {
      "name": "Token_Exchange",
      "description": "UAA",
      "scope-references": [
        "uaa.user"
      ]
    },
     {
      "name": "EmployeeViewer",
      "description": "UAA",
      "scope-references": [
        "$XSAPPNAME.EmployeeViewer"
      ]
    },
     {
      "name": "EmployeeAdmin",
      "description": "UAA",
      "scope-references": [
        "$XSAPPNAME.EmployeeAdmin"
      ]
    }
  ]
}
