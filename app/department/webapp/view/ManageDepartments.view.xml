<mvc:View
    controllerName="department.controller.ManageDepartments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:v="sap.ui.comp.variants"
    xmlns:form="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:tnt="sap.tnt"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:card="sap.f.cards"
    xmlns:table="sap.ui.table"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:l="sap.ui.layout"
    xmlns:field="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

    <f:DynamicPage
        id="pageDepartments"
        fitContent="true"
        headerExpanded="true"
        showFooter="{=!!${errors>/}.length}">

        <!-- Page Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        id="titleDepartments"
                        text="Departments"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Filter Header -->
        <f:header>
            <f:DynamicPageHeader pinnable="true">

                <fb:FilterBar
                    id="filterbar"
                    persistencyKey="myPersKey"
                    useToolbar="false"
                    search="advancedFilter"
                    showClearOnFB="true"
                    clear="clearAllFilters"
                    filterChange=".onFilterChange"
                    afterVariantLoad=".onAfterVariantLoad">

                    <fb:filterItems>

                        <!-- Company -->
                        <fb:FilterItem
                            name="A"
                            label="Company"
                            mandatory="true">

                            <fb:control>
                                <ComboBox
                                    id="cb_Company"
                                    placeholder="Select Company"
                                    items="{companyMdl>/}"
                                    selectedKey="{advancedFilterMdl>/company_id}"
                                    field:type="ComboBox"
                                    field:validate="required"
                                    change=".onChangeCompany">

                                    <core:Item
                                        key="{companyMdl>id}"
                                        text="{companyMdl>name}"/>

                                </ComboBox>
                            </fb:control>

                        </fb:FilterItem>

                        <!-- Name -->
                        <fb:FilterItem
                            name="B"
                            label="Name">

                            <fb:control>
                                <Input
                                    value="{advancedFilterMdl>/name}"
                                    placeholder="Enter Name"/>
                            </fb:control>

                        </fb:FilterItem>

                        <!-- Location -->
                        <fb:FilterItem
                            name="C"
                            label="Location">

                            <fb:control>
                                <ComboBox
                                    id="cb_location"
                                    items="{locationsMdl>/}"
                                    placeholder="Select Location"
                                    enabled="{= ${advancedFilterMdl>/company_id} ? true : false}"
                                    selectedKey="{advancedFilterMdl>/location_id}">

                                    <core:Item
                                        key="{locationsMdl>id}"
                                        text="{locationsMdl>location}"/>

                                </ComboBox>
                            </fb:control>

                        </fb:FilterItem>

                        <!-- Branch -->
                        <fb:FilterItem
                            name="D"
                            label="Branch">

                            <fb:control>
                                <ComboBox
                                    id="cb_branch"
                                    items="{branchesModel>/}"
                                    placeholder="Select Branch"
                                    enabled="{= ${advancedFilterMdl>/company_id} ? true : false}"
                                    selectedKey="{advancedFilterMdl>/branch_id}">

                                    <core:Item
                                        key="{branchesModel>id}"
                                        text="{branchesModel>name}"/>

                                </ComboBox>
                            </fb:control>

                        </fb:FilterItem>

                        <!-- Status -->
                        <fb:FilterItem
                            name="E"
                            label="Status">

                            <fb:control>
                                <ComboBox
                                    id="cb_Status"
                                    placeholder="Select Status"
                                    items="{masterDataMdl>/status}"
                                    selectedKey="{advancedFilterMdl>/status}">

                                    <core:Item
                                        text="{masterDataMdl>description}"
                                        key="{masterDataMdl>value}"/>

                                </ComboBox>
                            </fb:control>

                        </fb:FilterItem>

                    </fb:filterItems>

                </fb:FilterBar>

            </f:DynamicPageHeader>
        </f:header>

        <!-- Table -->
        <f:content>

            <Table
                id="tableDepartments"
                items="{gradesMdl>/}"
                mode="None"
                sticky="ColumnHeaders,HeaderToolbar"
                inset="false"
                class="sapUiSmallMarginTop"
                growing="true"
                growingScrollToLoad="true"
                growingThreshold="20">

                <!-- Toolbar -->
                <headerToolbar>

                    <OverflowToolbar>

                        <content>

                            <Label
                                design="Bold"
                                text="Items ({= ${gradesMdl>/}.length})"/>

                            <ToolbarSpacer/>

                            <Button
                                id="btn_CreateDepartments"
                                type="Ghost"
                                text="Create"
                                press=".onPressCreateDepartments"
                                enabled="{= ${advancedFilterMdl>/system_id} !== 5}"/>

                            <ToolbarSeparator/>

                            <Button
                                icon="sap-icon://download"
                                press=".handleExport"
                                tooltip="Download Excel"/>

                            <ToolbarSeparator/>

                            <OverflowToolbarButton
                                type="Transparent"
                                tooltip="Sort"
                                icon="sap-icon://sort"
                                press=".handleSortButtonPressed"/>

                            <OverflowToolbarButton
                                type="Transparent"
                                tooltip="Group"
                                icon="sap-icon://group-2"
                                press=".handleGroupButtonPressed"/>

                            <OverflowToolbarButton
                                type="Transparent"
                                icon="sap-icon://settings"
                                tooltip="Settings"
                                press=".handlePersoButtonPressed"/>

                        </content>

                    </OverflowToolbar>

                </headerToolbar>

                <!-- Columns -->
                <columns>

                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        popinDisplay="Inline">

                        <Label
                            text="Name"
                            design="Bold"/>

                    </Column>

                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        popinDisplay="Inline">

                        <Label
                            text="Company"
                            design="Bold"/>

                    </Column>

                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        popinDisplay="Inline">

                        <Label
                            text="Branch"
                            design="Bold"/>

                    </Column>

                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true"
                        popinDisplay="Inline">

                        <Label
                            text="Status"
                            design="Bold"/>

                    </Column>

                </columns>

                <!-- Rows -->
                <items>

                    <ColumnListItem
                        type="Navigation"
                        press=".onListItemPress">

                        <cells>

                            <Text
                                text="{gradesMdl>name}"
                                wrapping="false"/>

                            <Text
                                text="{gradesMdl>company_name}"
                                wrapping="false"/>

                            <Text
                                text="{gradesMdl>branch_name}"
                                wrapping="false"/>

                            <ObjectStatus
                                text="{= ${gradesMdl>status} === 0 ? 'Active' : 'Inactive'}"
                                state="{= ${gradesMdl>status} === 0 ? 'Success' : 'Error'}"/>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </f:content>

        <!-- Footer -->
        <f:footer>

            <Toolbar>

                <Button
                    id="btnDept"
                    visible="{=!!${errors>/}.length}"
                    icon="sap-icon://error"
                    type="Negative"
                    text="Error"
                    press=".handleMessagePopoverPress"
                    ariaHasPopup="Dialog"/>

            </Toolbar>

        </f:footer>

    </f:DynamicPage>

</mvc:View>