{
  "_version": "1.86.0",
  "sap.app": {
    "id": "holidaycalender",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.31.1",
      "toolsId": "7f528080-dd5e-4d77-a01a-e7446762f0df"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/service/Holiday/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Holiday_Calendar-manageHoliday": {
          "semanticObject": "Holiday_Calendar",
          "action": "manageHoliday",
          "title": "{{Holiday_Calendar-manageHoliday.flpTitle}}",
          "subTitle": "{{Holiday_Calendar-manageHoliday.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "holidaycalender.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "holiday_calendarList",
          "target": [
            "holiday_calendarList"
          ]
        },
        {
          "pattern": "holiday_calendar({key}):?query:",
          "name": "holiday_calendarObjectPage",
          "target": [
            "holiday_calendarList",
            "holiday_calendarObjectPage"
          ]
        }
      ],
      "targets": {
        "holiday_calendarList": {
          "type": "Component",
          "id": "holiday_calendarList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/holiday_calendar",
              "variantManagement": "Page",
              "navigation": {
                "holiday_calendar": {
                  "detail": {
                    "route": "holiday_calendarObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "columns": {
                    "DataField::leave_calendar_id": {
                      "width": "250px",
                      "widthIncludingColumnHeader": true
                    },
                    "DataField::calendar_name": {
                      "width": "645px",
                      "widthIncludingColumnHeader": true
                    },
                    "DataField::status": {
                      "width": "810px",
                      "widthIncludingColumnHeader": true
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages",
          "contextPattern": ""
        },
        "holiday_calendarObjectPage": {
          "type": "Component",
          "id": "holiday_calendarObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/holiday_calendar",
              "navigation": {},
              "controlConfiguration": {
                "holiday_calendar_dt/@com.sap.vocabularies.UI.v1.LineItem#HolidayDetails": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "columns": {
                    "DataField::from_date": {
                      "width": "314px",
                      "widthIncludingColumnHeader": true
                    },
                    "DataField::to_date": {
                      "width": "351px",
                      "widthIncludingColumnHeader": true
                    }
                  }
                }
              },
              "showRelatedApps": true
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/holiday_calendar({key})"
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "payroll_BN"
  }
}
