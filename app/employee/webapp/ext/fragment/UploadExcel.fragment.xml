<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified">

    <Dialog id="uploadDialog" title="Upload Excel" contentWidth="400px">

        <content>
            <VBox class="sapUiSmallMargin" gap="1rem">
                <Text text="Select an Excel file (.xlsx)"/>

                <u:FileUploader
                    id="excelUploader"
                    width="100%"
                    fileType="xlsx,xls"
                    placeholder="Choose Excel file"
                    change="onFileChange"/>
            </VBox>
        </content>

        <beginButton>
            <Button text="Upload" type="Emphasized" press="onConfirmUpload"/>
        </beginButton>

        <endButton>
            <Button text="Cancel" press="onCloseUploadDialog"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>