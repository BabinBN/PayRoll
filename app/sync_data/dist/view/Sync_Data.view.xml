<mvc:View controllerName="syncdata.controller.Sync_Data"
  xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:tnt="sap.tnt"
    xmlns:table="sap.ui.table"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:card="sap.f.cards"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:layout="sap.ui.layout">
    <!-- <Page id="page" title="{i18n>title}">
    </Page> -->
 <f:DynamicPage id="page_MngSyncErpData" headerExpanded="true" showFooter="{=!!${errors>/}.length}">
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Sync Erp Data"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
        </f:header>

        <f:content>
            <Table id= "tableId_companies" items="{Sync>/}" mode="None" sticky="ColumnHeaders,HeaderToolbar" inset="false" class="sapUiSmallMarginTop"  growing="true" growingScrollToLoad="true" growingThreshold="20">
                <headerToolbar>
                    <OverflowToolbar>
                        <content>
                            <!-- <Label  text="Items({= ${companyMdl>/}.length})" visible="{= ${companyMdl>/}.length>=0}" /> -->
                            <ToolbarSpacer />
                            <Button visible="true" enabled="false" icon="sap-icon://synchronize" tooltip="Sync-Data" type="Emphasized" press="syncpress"/>
                        </content>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="Data Object"  />
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
                        <Text text="Last Synced Date"  />
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
                        <Text text="Action"  />
                    </Column>
                    

                </columns>
                <items>
                    <ColumnListItem  press=".onListItemPress">
                        <cells>
                            <ObjectIdentifier title="{Sync>object_name}" />
                            <Text text="{path: 'Sync>synced_date', formatter: '.formatter.formatDateTime'}" />
                            <!-- <Text text="{Sync>synced_date}" wrapping="false"/> -->
                            <!-- <Text text="{path: 'Sync>synced_date', formatter: '.formatter.convertDateandTime'}" wrapping="false"/> -->
                            <!-- <Text text="{Sync>date} {parts:[{path:'settings>/userSettings/timeFormatKey'}, {path:'Sync>time'}], formatter: '.getTimeFormats'}" wrapping="false" /> -->
                            <Button visible="true" icon="sap-icon://synchronize" tooltip="Sync-Data" type="Emphasized" press="onPressSyncData"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
        <f:footer>
            <Bar>
                <contentLeft>
                    <Button id="btnMngSyncErpData" class="sapUiTinyMarginTop" visible="{=!!${errors>/}.length}" icon="sap-icon://error" type="Negative" text="{i18n>eg_btnErr}" press=".handleMessagePopoverPress" ariaHasPopup="Dialog" />
                </contentLeft>
            </Bar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>    