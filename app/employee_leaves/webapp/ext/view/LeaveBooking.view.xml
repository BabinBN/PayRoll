<mvc:View
    controllerName="employeeleaves.ext.controller.LeaveBooking"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:tnt="sap.tnt"
    xmlns:table="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield"
    xmlns:card="sap.f.cards"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:layout="sap.ui.layout">
    
     <f:DynamicPage id="page_BookLeaveOnDuty" showFooter="{=!!${errors>/}.length}">
        <!-- DynamicPage Title -->
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Bulk Leave / On Duty Booking" />
                </f:heading>
                <f:actions>
                    <Button id="btnSaveClose" type="Transparent" text="Save &amp; Close" press="bulkPostLeave" />
                    <Button id="btnClose" type="Transparent" text="Close" class="sapUiTinyMarginBegin" press="handleClose" />
                </f:actions>
                <f:navigationActions>
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://full-screen"
                        press="handleFullScreen" id="enterFullScreenBtn"
                        tooltip="Enter Full Screen Mode"
                        visible="{= ${/actionButtonsInfo/midColumn/fullScreen} !== null }" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://exit-full-screen"
                        press="handleExitFullScreen" id="exitFullScreenBtn"
                        tooltip="Exit Full Screen Mode"
                        visible="{parts:['/actionButtonsInfo/midColumn/exitFullScreen' , 'leaveBookingMdl>/item'], formatter:'.formatter.showHideFullScreen'}" />
                    <OverflowToolbarButton type="Transparent" icon="sap-icon://decline"
                        press="handleClose" tooltip="Close end column"
                        visible="{= ${/actionButtonsInfo/midColumn/closeColumn} !== null }" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:content>
            <VBox id="VBox_Main_id">
                <VBox>
                    <HBox alignItems="End" justifyContent="End">
                        <Button id="btn_addBulkEmployee" text="Add Employees" type="Ghost" press="onPressAddRowHeader" />
                    </HBox>
                </VBox>
                
                <VBox id="VBox_id" items="{leaveBookingMdl>/}">
                    <Panel expandable="true" width="auto" class="sapUiResponsiveMargin">
                        <headerToolbar>
                            <OverflowToolbar active="true" press="onOverflowToolbarPress">
                                <HBox>
                                    <Label text="Employee:" class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop" required="true" />
                                    <Input id="empID" class="sapUiSmallMarginEnd" type="Text"
                                        value="{leaveBookingMdl>emp_code}"
                                        placeholder="Please select an employee"
                                        showValueHelp="true" valueHelpOnly="true"
                                        valueHelpRequest=".valueHelpDialogEmployee"
                                        valueState="{leaveBookingMdl>emp_code_state}"
                                        valueStateText="{leaveBookingMdl>emp_code_stateText}" />

                                    <Label text="Booking Type:" class="sapUiTinyMarginBeginEnd sapUiTinyMarginTop" required="true" />
                                    <ComboBox id="addBookingType"
                                        enabled="{= ${leaveBookingMdl>employee_id} !== null &amp;&amp; ${leaveBookingMdl>employee_id} !== undefined ? true : false}"
                                        class="sapUiTinyMarginBegin"
                                        items="{masterDataMdl>/leave_booking_type}"
                                        placeholder="Select Booking Type"
                                        selectedKey="{leaveBookingMdl>type}"
                                        change="onChangeBookingType"
                                        valueState="{leaveBookingMdl>type_state}"
                                        valueStateText="{leaveBookingMdl>leave_definitions_id_stateText}">
                                        <core:ListItem key="{masterDataMdl>value}" text="{masterDataMdl>description}" />
                                    </ComboBox>
                                </HBox>
                                <ToolbarSpacer />
                                <Button text="Delete" type="Ghost" press="onPressRemoveRowHeader" tooltip="Remove Item" class="sapUiTinyMarginBegin" />
                            </OverflowToolbar>
                        </headerToolbar>
                        
                        <content>
                            <ScrollContainer horizontal="true" vertical="false" width="100%">
                                <Table id="leaveTable"
                                    width="160rem"
                                    visible="{= ${leaveBookingMdl>type} === '2' ? true : false }"
                                    items="{path: 'leaveBookingMdl>leaveDetails'}" mode="None"
                                    sticky="ColumnHeaders,HeaderToolbar" inset="false">
                                    <columns>
                                        <Column hAlign="Center"><Label text="Leave Type" required="true" /></Column>
                                        <Column hAlign="Center"><Label text="From Date" required="true" /></Column>
                                        <Column hAlign="Center"><Label text="From Date Type" required="true" /></Column>
                                        <Column hAlign="Center"><Label text="To Date" required="true" /></Column>
                                        <Column hAlign="Center"><Label text="To Date Type" required="true" /></Column>
                                        <Column hAlign="Center"><Label text="Return Date" required="{= ${configureSyncMdl>/0/sync_status} === 1 }" /></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem>
                                            <cells>
                                                <Input value="{leaveBookingMdl>leave_type}" />
                                                <DatePicker value="{leaveBookingMdl>from_date}" />
                                                <Input value="{leaveBookingMdl>from_date_type}" />
                                                <DatePicker value="{leaveBookingMdl>to_date}" />
                                                <Input value="{leaveBookingMdl>to_date_type}" />
                                                <DatePicker value="{leaveBookingMdl>return_date}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </ScrollContainer>
                        </content>
                    </Panel>
                </VBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
